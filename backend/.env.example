# ── Server ────────────────────────────────────────────────
PORT=3001

# ── Database adapter: "postgres" | "supabase" ─────────────
DB_ADAPTER=postgres

# Postgres (used when DB_ADAPTER=postgres)
DATABASE_URL=postgres://dostt:dostt_secret@localhost:5432/dostt_rewards

# Supabase (used when DB_ADAPTER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cycle length ─────────────────────────────────────────
# Each user's 30-day cycle starts from their first login date.
# The go-live date is baked into the BigQuery source query — no env var needed.
CYCLE_DAYS=30

# ── Redash ────────────────────────────────────────────────
REDASH_BASE_URL=https://app.redash.io/yourslug
REDASH_API_KEY=your_query_or_user_api_key

# Query ID for verifying a phone is a registered Dostt user
# Expected columns: user_id, mobile_no (at minimum)
# Parameter: {{ mobile_numbers }}
# Leave blank to skip verification (dev mode — allows any number)
REDASH_VERIFY_PHONE_QUERY_ID=17538

# Query ID for fetching per-user points (parameterized — returns 1 row)
# Expected columns: user_id, mobile_no, wallet_balance, spent_on_audio,
#   spent_on_video, total_spent, last_refreshed_at_ist, ltv
# Parameter: {{ user_id }}
# Cached in user_points table with 2-hour TTL (matches BigQuery refresh cadence).
REDASH_USER_POINTS_QUERY_ID=17564

# Query ID for bulk-syncing all banner-funnel users every 30 min (no parameters).
# Expected columns: same as above but no WHERE filter — returns all users.
# Used to populate points_raw_cache; backend falls back to this if live Redash fetch fails.
REDASH_ALL_USERS_QUERY_ID=18796

# ── Dostt Wallet API ──────────────────────────────────────
# Used to credit free coins after a successful tier claim.
DOSTT_WALLET_API_URL=https://api.dostt.in/payments/free-coins/upload/
DOSTT_WALLET_AUTH_KEY=your_x-n8n-auth-key

# ── Admin reporting API ───────────────────────────────────
# Set to a long random string. Pass as x-admin-key header to /admin/* endpoints.
# Endpoints (all require x-admin-key header):
#   GET /api/admin/reports/login-logs?phone=&status=&limit=100
#   GET /api/admin/reports/claim-logs?phone=&status=&tier_id=&limit=100
#   GET /api/admin/reports/user-performance?phone=
#   GET /api/admin/reports/eligible-not-claimed
#
# Claim status values:
#   pending         — started but not resolved (indicates a crash mid-flow)
#   success         — coins credited to wallet
#   failed          — wallet API failed, claim rolled back, user can retry
#   failed_unrolled — wallet failed AND rollback failed; manual fix required:
#                     DELETE FROM claimed_rewards WHERE id = <id_in_failure_reason>
#   duplicate       — concurrent request race; 409 returned to user
ADMIN_API_KEY=change_me_to_a_long_random_string
